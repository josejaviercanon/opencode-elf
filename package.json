{
  "name": "opencode-elf",
  "version": "0.7.0",
  "description": "Emergent Learning Framework (ELF) plugin for OpenCode - Learn from past successes and failures with hybrid global/project storage",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "node scripts/prepare.mjs",
    "pack:dist": "npm pack",
    "rules:add": "node scripts/manage-rules.js add",
    "rules:list": "node scripts/manage-rules.js list",
    "rules:seed": "node scripts/seed-rules.js",
    "heuristics:add": "node scripts/manage-heuristics.js add",
    "heuristics:list": "node scripts/manage-heuristics.js list",
    "heuristics:seed": "node scripts/seed-heuristics.js",
    "learnings:view": "node scripts/view-learnings.js",
    "metrics:view": "node scripts/view-metrics.js",
    "cleanup:preview": "node scripts/cleanup-expired.js preview",
    "cleanup:clean": "node scripts/cleanup-expired.js clean",
    "test:compat": "ts-node tests/compat.test.ts",
    "test:simulate": "ts-node tests/simulate.ts",
    "test:hybrid": "ts-node tests/test-hybrid.ts",
    "test:benchmark": "ts-node tests/benchmark.ts",
    "test:parity": "ts-node tests/test-parity.ts"
  },
  "keywords": [
    "opencode",
    "plugin",
    "elf",
    "learning",
    "memory",
    "embeddings"
  ],
  "author": "Mark Hingston",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mark-hingston/opencode-elf"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@libsql/client": "^0.14.0",
    "@opencode/plugin": "^2.0.16"
  },
  "//": "Native stack is aligned with opencode-mem so both plugins can share DLLs in one OpenCode process: @huggingface/transformers 4.x + onnxruntime-node 1.20.1 + sharp 0.35.4. Windows resolves native DLLs by base name and reuses the first loaded module; mismatched onnxruntime.dll / libvips-42.dll versions crash the second plugin (ERROR_INVALID_ORDINAL 182 / ERROR_PROC_NOT_FOUND 127). @xenova/transformers is not compatible with onnxruntime-node 1.20.1 ('Tensor.data must be a typed array'). See README 'Running with opencode-mem'.",
  "overrides": {
    "onnxruntime-node": "1.20.1",
    "onnxruntime-web": "1.20.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "index.ts",
    "scripts/prepare.mjs"
  ],
  "allowScripts": {
    "protobufjs": true,
    "sharp": true,
    "msgpackr-extract": true,
    "onnxruntime-node": true
  }
}
